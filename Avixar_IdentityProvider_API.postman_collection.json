{
    "info": {
        "name": "Avixar Identity Provider API",
        "description": "Complete API collection for testing Avixar Identity Provider OAuth flows, user management, and organization management",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "2.0.0"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "https://localhost:7001",
            "type": "string"
        },
        {
            "key": "ui_base_url",
            "value": "https://localhost:7000",
            "type": "string"
        },
        {
            "key": "client_id",
            "value": "test_client_123",
            "type": "string"
        },
        {
            "key": "client_secret",
            "value": "test_secret_456",
            "type": "string"
        },
        {
            "key": "redirect_uri",
            "value": "http://localhost:3000/callback",
            "type": "string"
        },
        {
            "key": "auth_code",
            "value": "",
            "type": "string"
        },
        {
            "key": "access_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "refresh_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "org_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "user_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Authentication (UI)",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "Email",
                                    "value": "testuser@example.com",
                                    "type": "text"
                                },
                                {
                                    "key": "Password",
                                    "value": "Test@123456",
                                    "type": "text"
                                },
                                {
                                    "key": "DisplayName",
                                    "value": "Test User",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/Auth/Register",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "Auth",
                                "Register"
                            ]
                        },
                        "description": "Register a new user account"
                    },
                    "response": []
                },
                {
                    "name": "Login User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "Email",
                                    "value": "testuser@example.com",
                                    "type": "text"
                                },
                                {
                                    "key": "Password",
                                    "value": "Test@123456",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/Auth/Login",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "Auth",
                                "Login"
                            ]
                        },
                        "description": "Login with email and password. This will set authentication cookies."
                    },
                    "response": []
                }
            ],
            "description": "User authentication endpoints (UI application)"
        },
        {
            "name": "2. OAuth Authorization Flow",
            "item": [
                {
                    "name": "Step 1: Authorize (Get Auth Code)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{ui_base_url}}/connect/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&response_type=code&state=random_state_123&nonce=random_nonce_456&scope=openid profile email",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "connect",
                                "authorize"
                            ],
                            "query": [
                                {
                                    "key": "client_id",
                                    "value": "{{client_id}}",
                                    "description": "OAuth Client ID"
                                },
                                {
                                    "key": "redirect_uri",
                                    "value": "{{redirect_uri}}",
                                    "description": "Callback URL"
                                },
                                {
                                    "key": "response_type",
                                    "value": "code",
                                    "description": "Must be 'code' for authorization code flow"
                                },
                                {
                                    "key": "state",
                                    "value": "random_state_123",
                                    "description": "Random state for CSRF protection"
                                },
                                {
                                    "key": "nonce",
                                    "value": "random_nonce_456",
                                    "description": "Random nonce for replay protection"
                                },
                                {
                                    "key": "scope",
                                    "value": "openid profile email",
                                    "description": "Requested scopes"
                                }
                            ]
                        },
                        "description": "**IMPORTANT**: User must be logged in first!\n\n1. First login via UI (/Auth/Login)\n2. Then call this endpoint\n3. If authenticated, you'll be redirected to: redirect_uri?code=XXXXX&state=random_state_123\n4. Copy the 'code' from the redirect URL\n5. Save it to the {{auth_code}} variable"
                    },
                    "response": []
                },
                {
                    "name": "Step 2: Exchange Code for Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "client_id",
                                    "value": "{{client_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "client_secret",
                                    "value": "{{client_secret}}",
                                    "type": "text"
                                },
                                {
                                    "key": "code",
                                    "value": "{{auth_code}}",
                                    "type": "text",
                                    "description": "Authorization code from Step 1"
                                },
                                {
                                    "key": "redirect_uri",
                                    "value": "{{redirect_uri}}",
                                    "type": "text"
                                },
                                {
                                    "key": "grant_type",
                                    "value": "authorization_code",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/connect/token",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "connect",
                                "token"
                            ]
                        },
                        "description": "Exchange authorization code for access token and refresh token.\n\n**Before running**: Set {{auth_code}} variable with the code from Step 1\n\n**Response includes**:\n- access_token: JWT for API access\n- refresh_token: Token for refreshing access\n- expires_in: Token expiration time"
                    },
                    "response": []
                },
                {
                    "name": "Step 2b: Refresh Access Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/x-www-form-urlencoded"
                            }
                        ],
                        "body": {
                            "mode": "urlencoded",
                            "urlencoded": [
                                {
                                    "key": "client_id",
                                    "value": "{{client_id}}",
                                    "type": "text"
                                },
                                {
                                    "key": "client_secret",
                                    "value": "{{client_secret}}",
                                    "type": "text"
                                },
                                {
                                    "key": "refresh_token",
                                    "value": "{{refresh_token}}",
                                    "type": "text",
                                    "description": "Refresh token from Step 2"
                                },
                                {
                                    "key": "grant_type",
                                    "value": "refresh_token",
                                    "type": "text"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/connect/token",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "connect",
                                "token"
                            ]
                        },
                        "description": "Use refresh token to get a new access token without re-authentication.\n\n**Before running**: Set {{refresh_token}} variable with the refresh_token from Step 2"
                    },
                    "response": []
                },
                {
                    "name": "Step 3: Get User Info",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/connect/userinfo",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "connect",
                                "userinfo"
                            ]
                        },
                        "description": "Get user information using the access token.\n\n**Before running**: Set {{access_token}} variable with the token from Step 2\n\n**Returns**: User profile including sub, name, email, picture"
                    },
                    "response": []
                },
                {
                    "name": "Step 4: Logout",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{ui_base_url}}/connect/logout?post_logout_redirect_uri=http://localhost:3000/&client_id={{client_id}}",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "connect",
                                "logout"
                            ],
                            "query": [
                                {
                                    "key": "post_logout_redirect_uri",
                                    "value": "http://localhost:3000/"
                                },
                                {
                                    "key": "client_id",
                                    "value": "{{client_id}}"
                                }
                            ]
                        },
                        "description": "Logout user and redirect to specified URI. Clears authentication cookies."
                    },
                    "response": []
                }
            ],
            "description": "Complete OAuth 2.0 Authorization Code Flow with Refresh Token support"
        },
        {
            "name": "3. Organization Management",
            "item": [
                {
                    "name": "List User Organizations",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs"
                            ]
                        },
                        "description": "Get all organizations the authenticated user belongs to.\n\n**Requires**: Bearer token authentication\n\n**Returns**: List of organizations with id, name, slug, role information"
                    },
                    "response": []
                },
                {
                    "name": "Get Organization Contexts",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/contexts",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "contexts"
                            ]
                        },
                        "description": "Get organization contexts for context switcher UI.\n\n**Requires**: Bearer token authentication\n\n**Returns**: Simplified list with org_id, org_name, role_name"
                    },
                    "response": []
                },
                {
                    "name": "Create Organization",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"My New Organization\",\n    \"slug\": \"my-new-org\"\n}"
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs"
                            ]
                        },
                        "description": "Create a new organization. Creator is automatically assigned OWNER role.\n\n**Requires**: Bearer token authentication\n\n**Body**:\n- name: Organization name (required)\n- slug: URL-friendly identifier (optional)"
                    },
                    "response": []
                },
                {
                    "name": "Switch Organization Context",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"org_id\": \"{{org_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/switch-context",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "switch-context"
                            ]
                        },
                        "description": "Switch to a different organization context. Returns new JWT with org_id, role_id, and role_name claims.\n\n**Requires**: Bearer token authentication\n\n**Body**:\n- org_id: Organization ID to switch to (required)\n\n**Returns**: New access token with updated context"
                    },
                    "response": []
                }
            ],
            "description": "Organization management endpoints - create, list, and switch between organizations"
        },
        {
            "name": "4. Organization Members",
            "item": [
                {
                    "name": "List Organization Members",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/{{org_id}}/members",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "{{org_id}}",
                                "members"
                            ]
                        },
                        "description": "Get all members of an organization.\n\n**Requires**: Bearer token authentication + membership in the organization\n\n**Returns**: List of members with user details and role information"
                    },
                    "response": []
                },
                {
                    "name": "Invite Member to Organization",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"newmember@example.com\",\n    \"role_id\": 4\n}"
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/{{org_id}}/members/invite",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "{{org_id}}",
                                "members",
                                "invite"
                            ]
                        },
                        "description": "Invite a new member to the organization.\n\n**Requires**: Bearer token authentication + OWNER or ADMIN role\n\n**Body**:\n- email: Email of user to invite (required)\n- role_id: Role to assign (1=OWNER, 2=ADMIN, 3=MANAGER, 4=USER)\n\n**Note**: Sends email invitation to the user"
                    },
                    "response": []
                },
                {
                    "name": "Update Member Role",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"new_role_id\": 3\n}"
                        },
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/{{org_id}}/members/{{user_id}}/roles",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "{{org_id}}",
                                "members",
                                "{{user_id}}",
                                "roles"
                            ]
                        },
                        "description": "Update a member's role in the organization.\n\n**Requires**: Bearer token authentication + OWNER or ADMIN role\n\n**Body**:\n- new_role_id: New role to assign (1=OWNER, 2=ADMIN, 3=MANAGER, 4=USER)\n\n**Restrictions**:\n- Cannot modify OWNER role\n- Only OWNER can assign ADMIN role"
                    },
                    "response": []
                },
                {
                    "name": "Remove Member from Organization",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/api/orgs/{{org_id}}/members/{{user_id}}",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "api",
                                "orgs",
                                "{{org_id}}",
                                "members",
                                "{{user_id}}"
                            ]
                        },
                        "description": "Remove a member from the organization.\n\n**Requires**: Bearer token authentication + OWNER or ADMIN role\n\n**Restrictions**:\n- Cannot remove OWNER\n- Invalidates member cache automatically"
                    },
                    "response": []
                }
            ],
            "description": "Organization member management - invite, update roles, and remove members"
        },
        {
            "name": "5. User Profile Management",
            "item": [
                {
                    "name": "Get User Profile",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Cookie",
                                "value": ".AspNetCore.Cookies=YOUR_COOKIE_VALUE",
                                "type": "text",
                                "description": "Copy from browser after login"
                            }
                        ],
                        "url": {
                            "raw": "{{ui_base_url}}/Account/Index",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                "Account",
                                "Index"
                            ]
                        },
                        "description": "Get current user's profile. Requires authentication cookie."
                    },
                    "response": []
                }
            ],
            "description": "User profile and account management"
        },
        {
            "name": "6. Health Check",
            "item": [
                {
                    "name": "API Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                ""
                            ]
                        },
                        "description": "Check if API is running"
                    },
                    "response": []
                },
                {
                    "name": "UI Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{ui_base_url}}/",
                            "host": [
                                "{{ui_base_url}}"
                            ],
                            "path": [
                                ""
                            ]
                        },
                        "description": "Check if UI is running"
                    },
                    "response": []
                }
            ],
            "description": "Health check endpoints"
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Auto-save access_token from token response",
                    "if (pm.response.code === 200 && pm.response.json().access_token) {",
                    "    pm.collectionVariables.set('access_token', pm.response.json().access_token);",
                    "    console.log('✓ Access token saved to collection variable');",
                    "}",
                    "",
                    "// Auto-save refresh_token from token response",
                    "if (pm.response.code === 200 && pm.response.json().refresh_token) {",
                    "    pm.collectionVariables.set('refresh_token', pm.response.json().refresh_token);",
                    "    console.log('✓ Refresh token saved to collection variable');",
                    "}"
                ]
            }
        }
    ]
}